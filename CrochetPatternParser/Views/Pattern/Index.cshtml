@model CrochetPatternParser.Models.PatternViewModel
@{
    ViewData["Title"] = "Crochet Pattern Validator";
}

<div class="pattern-validator-container">
    <div class="page-header">
        <h2>🧶 Crochet Pattern Validator</h2>
        <p class="subtitle">No more math ain't mathing moments!</p>
    </div>

    @if (TempData["FromSaveAttempt"] != null && TempData["FromSaveAttempt"]?.ToString() == "True")
    {
        <div class="alert alert-info" role="alert">
            <strong>Welcome back!</strong> Your pattern has been restored. You can now save it.
            @{
                TempData.Remove("FromSaveAttempt");
            }
        </div>
    }

    <form method="post" class="section-container" enctype="multipart/form-data">
        <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>
        @if (ViewBag.PatternId != null)
        {
            <input type="hidden" name="patternId" value="@ViewBag.PatternId" />
        }
        @if (!string.IsNullOrEmpty(Model?.ImagePath))
        {
            <input type="hidden" asp-for="ImagePath" />
        }
        
        <div class="section-group">
            <label for="patternTitle" class="section-label">Pattern Title</label>
            <input type="text" asp-for="Title" id="patternTitle" class="form-control styled-text-input" placeholder="Enter your pattern title..." />
        </div>

        <div class="section-group">
            <label for="patternImage" class="section-label">📸 Pattern Image (Optional)</label>
            @if (!string.IsNullOrEmpty(Model?.ImagePath))
            {
                <div class="current-image-preview">
                    <img src="@Model.ImagePath" alt="Current pattern image" />
                    <p class="current-image-label">Current Image</p>
                </div>
            }
            <input type="file" asp-for="ImageFile" id="patternImage" class="form-control image-upload-input" accept="image/*" onchange="previewImage(event)" />
            <div id="imagePreview" class="image-preview" style="display: none;">
                <img id="previewImg" alt="Image preview" />
            </div>
        </div>

    <div class="section-group">
        <label class="section-label">Pattern Rounds</label>
        <div id="roundsContainer">
            @if (Model?.Sections != null && Model.Sections.Count > 0)
            {
                @for (int i = 0; i < Model.Sections.Count; i++)
                {
                    @for (int j = 0; j < Model.Sections[i].RoundTexts.Count; j++)
                    {
                        <div class="round-input-group" data-round-index="@j">
                            <div class="round-header">
                                <label class="round-label">Round @(j + 1)</label>
                                <button type="button" class="btn-delete-round" onclick="deleteRound(this)" title="Delete this round">🗑️</button>
                            </div>
                            <textarea name="Sections[@i].RoundTexts[@j]" rows="2" class="round-text form-control">@Model.Sections[i].RoundTexts[j]</textarea>
                        </div>
                    }
                }
            }
            else
            {
                <div class="round-input-group" data-round-index="0">
                    <div class="round-header">
                        <label class="round-label">Round 1</label>
                        <button type="button" class="btn-delete-round" onclick="deleteRound(this)" title="Delete this round">🗑️</button>
                    </div>
                    <textarea name="Sections[0].RoundTexts[0]" rows="2" class="round-text form-control"></textarea>
                </div>
            }
        </div>
    </div>

    <div class="pattern-form-actions">
        <button type="button" class="btn btn-add-round" onclick="addSection()">➕ Add Section</button>
        <button type="button" class="btn btn-add-round" onclick="addRound()">➕ Add Round</button>
        
        <div class="submit-buttons">
            <button type="submit" 
                    asp-action="Validate"
                    asp-controller="Pattern"
                    class="btn btn-validate"
                    id="validateButton">
                ✓ Validate Pattern
            </button>
            <button type="submit"
                    asp-action="Save"
                    asp-controller="Pattern"
                    class="btn btn-save"
                    id="saveButton">
                💾 Save Pattern
            </button>
            <button type="button"
                    class="btn btn-save"
                    id="previewButton"
                    onclick="togglePreview()">
                👁️ Preview Pattern
            </button>
        </div>
    </div>
</form>

@if (Model?.Sections != null && Model.Sections.Count > 0)
{
    <div class="validation-results">
        <h3 class="results-title">Validation Results</h3>
        <div class="results-list">
        @foreach (var section in Model.Sections)
        {
            @foreach (var round in section.Rounds)
            {
                if (!string.IsNullOrEmpty(round.Error))
                {
                    <div class="result-item result-error">
                        <span class="result-icon">❌</span>
                        <div class="result-content">
                            <strong>Round @round.RoundIndex</strong>
                            <p>@round.Error</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="result-item result-success">
                        <span class="result-icon">✅</span>
                        <div class="result-content">
                            <strong>Round @round.RoundIndex</strong>
                            <p>@round.StitchCount stitches</p>
                        </div>
                    </div>
                }
            }
        }
        </div>
    </div>
}

<div id="patternPreview" class="pattern-preview-container" style="display: none;">
    <div class="section-container">
        <h3 class="results-title">📖 Pattern Preview</h3>
        <div id="previewContent" class="preview-content">
            @if (Model?.Sections != null && Model.Sections.Count > 0)
            {
                <div class="preview-header">
                    <h2>@(string.IsNullOrEmpty(Model.Title) ? "Untitled Pattern" : Model.Title)</h2>
                    <p class="preview-date">Created: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
                </div>
                <div class="preview-rounds">
                    @for (int i = 0; i < Model.Sections.Count; i++)
                    {
                        var section = Model.Sections[i];
                        @for (int j = 0; j < section.Rounds.Count; j++)
                        {
                            var round = section.Rounds[j];
                            var roundText = j < section.RoundTexts.Count ? section.RoundTexts[j] : "";
                            
                            <div class="preview-round">
                            <div class="preview-round-header">
                                <h3>Round @(i + 1)</h3>
                                <span class="preview-stitch-count">@round.StitchCount stitches</span>
                            </div>
                            <p class="preview-round-text">@roundText</p>
                        </div>
                        }
                    }
                </div>
            }
            else
            {
                <p class="preview-empty">No rounds added yet. Add a round to see the preview.</p>
            }
        </div>
    </div>
</div>
</div>


@section Scripts {
    <script>
        // State
        let roundCounter = Math.max(@(Model?.Sections?.FirstOrDefault()?.RoundTexts?.Count ?? 0), 1);
        let isDirty = false;
        let hasValidated = @((Model?.Sections != null && Model.Sections.Any(s => s.Rounds.Count > 0)) ? "true" : "false");

        // Round management
        function addRound() {
            const container = document.getElementById("roundsContainer");
            const roundDiv = document.createElement("div");
            roundDiv.className = "round-input-group";
            roundDiv.innerHTML = `
                <div class="round-header">
                    <label class="round-label">Round ${roundCounter + 1}</label>
                    <button type="button" class="btn-delete-round" onclick="deleteRound(this)" title="Delete this round">🗑️</button>
                </div>
                <textarea name="Sections[0].RoundTexts[${roundCounter}]" rows="2" class="round-text form-control"></textarea>
            `;
            container.appendChild(roundDiv);
            roundCounter++;
            isDirty = true;
        }

        function deleteRound(button) {
            button.closest('.round-input-group').remove();
            reindexRounds();
            isDirty = true;
        }

        function reindexRounds() {
            document.querySelectorAll('.round-input-group').forEach((round, index) => {
                round.querySelector('.round-label').textContent = `Round ${index + 1}`;
                round.querySelector('textarea').name = `Sections[0].RoundTexts[${index}]`;
            });
            roundCounter = document.querySelectorAll('.round-input-group').length;
        }

        // Form submission handling
        function setupFormHandlers() {
            document.querySelector('form')?.addEventListener('submit', () => {
                reindexRounds();
                isDirty = false;
                hasValidated = false;
            });

            document.getElementById("validateButton")?.addEventListener("click", () => {
                isDirty = false;
                hasValidated = false;
            });
            
            document.getElementById("saveButton")?.addEventListener("click", () => {
                isDirty = false;
                hasValidated = false;
            });
        }

        // Input tracking
        function setupInputTracking() {
            document.addEventListener('input', (e) => {
                if (e.target.classList.contains('round-text')) {
                    isDirty = true;
                    hasValidated = false;
                }
            });
        }

        // Keyboard shortcuts
        function setupKeyboardShortcuts() {
            document.addEventListener('keydown', (e) => {
                if (!e.target.classList.contains('round-text')) return;

                const textareas = Array.from(document.querySelectorAll('.round-text'));
                const currentIndex = textareas.indexOf(e.target);

                if (e.key === 'Enter' && !e.shiftKey) {
                    e.preventDefault();
                    addRound();
                    setTimeout(() => {
                        const allTextareas = document.querySelectorAll('.round-text');
                        allTextareas[allTextareas.length - 1]?.focus();
                    }, 0);
                } 
                else if (e.key === 'Delete' && e.ctrlKey) {
                    e.preventDefault();
                    const rounds = document.querySelectorAll('.round-input-group');
                    if (rounds.length > 1) {
                        e.target.closest('.round-input-group').remove();
                        reindexRounds();
                        isDirty = true;
                        setTimeout(() => {
                            const allTextareas = document.querySelectorAll('.round-text');
                            const focusIndex = Math.min(currentIndex, allTextareas.length - 1);
                            allTextareas[focusIndex]?.focus();
                        }, 0);
                    }
                } 
                else if (e.key === 'ArrowUp' && e.ctrlKey) {
                    e.preventDefault();
                    if (currentIndex > 0) {
                        textareas[currentIndex - 1]?.focus();
                    }
                } 
                else if (e.key === 'ArrowDown' && e.ctrlKey) {
                    e.preventDefault();
                    if (currentIndex < textareas.length - 1) {
                        textareas[currentIndex + 1]?.focus();
                    }
                }
            });
        }

        // Unsaved changes warning
        function setupUnsavedWarning() {
            window.addEventListener("beforeunload", (e) => {
                if (hasValidated || isDirty) {
                    e.preventDefault();
                    e.returnValue = '';
                }
            });
        }

        // Image preview
        function previewImage(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const preview = document.getElementById('imagePreview');
                    const previewImg = document.getElementById('previewImg');
                    previewImg.src = e.target.result;
                    preview.style.display = 'block';
                    
                    // Hide current image if showing new one
                    const currentImage = document.querySelector('.current-image-preview');
                    if (currentImage) {
                        currentImage.style.display = 'none';
                    }
                };
                reader.readAsDataURL(file);
                isDirty = true;
            }
        }

        // Pattern Preview Toggle
        function togglePreview() {
            const previewContainer = document.getElementById('patternPreview');
            const isVisible = previewContainer.style.display !== 'none';
            previewContainer.style.display = isVisible ? 'none' : 'block';
        }

        // Initialize all handlers
        setupFormHandlers();
        setupInputTracking();
        setupKeyboardShortcuts();
        setupUnsavedWarning();
    </script>
}