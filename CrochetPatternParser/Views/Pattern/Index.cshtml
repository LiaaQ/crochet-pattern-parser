<form method="post" asp-action="Index">
    <textarea name="pattern" rows="6" cols="60">@ViewBag.Pattern</textarea>
    <br />
    <button type="submit">Validate</button>
</form>

@if (ViewBag.Message != null)
{
    <div><strong>@ViewBag.Message</strong></div>
}

@if (ViewBag.Tokens != null)
{
    <ul>
        @foreach (var token in (List<CrochetPatternParser.Core.Tokenizer.Token>)ViewBag.Tokens)
        {
            <li>@token.Type — "@token.Lexeme"</li>
        }
    </ul>
}
