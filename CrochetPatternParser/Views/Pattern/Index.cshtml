@model CrochetPatternParser.Models.PatternViewModel
@using CrochetPatternParser.Models
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model?.Title) ? "Untitled Pattern" : Model.Title;

    var sections = Model?.Sections != null && Model.Sections.Count > 0
        ? Model.Sections
        : new List<SectionViewModel>
        {
            new SectionViewModel
            {
                SectionName = "Section 1",
                RoundTexts = new List<string> { string.Empty }
            }
        };
}

<div class="pattern-validator-container">
    <div class="page-header">
        <h2>@ViewData["Title"]</h2>
    </div>

    @if (TempData["FromSaveAttempt"] != null && TempData["FromSaveAttempt"]?.ToString() == "True")
    {
        <div class="alert alert-info" role="alert">
            <strong>Welcome back!</strong> Your pattern has been restored. You can now save it.
            @{
                TempData.Remove("FromSaveAttempt");
            }
        </div>
    }

    <form method="post" class="section-container" enctype="multipart/form-data" id="patternForm">
        <div asp-validation-summary="ModelOnly" class="text-danger validation-summary"></div>

        @if (ViewBag.PatternId != null)
        {
            <input type="hidden" name="patternId" value="@ViewBag.PatternId" />
        }

        @if (!string.IsNullOrEmpty(Model?.ImagePath))
        {
            <input type="hidden" asp-for="ImagePath" />
        }

        <div class="section-group">
            <label for="patternTitle" class="section-label">Pattern Title</label>
            <input type="text" asp-for="Title" id="patternTitle" class="form-control styled-text-input" placeholder="Enter your pattern title..." />
        </div>

        <div class="section-group">
            <label for="patternImage" class="section-label">📸 Pattern Image (Optional)</label>
            @if (!string.IsNullOrEmpty(Model?.ImagePath))
            {
                <div class="current-image-preview">
                    <img src="@Model.ImagePath" alt="Current pattern image" />
                    <p class="current-image-label">Current Image</p>
                </div>
            }
            <input type="file" asp-for="ImageFile" id="patternImage" class="form-control image-upload-input" accept="image/*" onchange="previewImage(event)" />
            <div id="imagePreview" class="image-preview" style="display: none;">
                <img id="previewImg" alt="Image preview" />
            </div>
        </div>

        <div id="sectionsContainer">
            @for (var i = 0; i < sections.Count; i++)
            {
                var section = sections[i];
                var roundTexts = section.RoundTexts.Count > 0 ? section.RoundTexts : new List<string> { string.Empty };
                var sectionName = string.IsNullOrWhiteSpace(section.SectionName) ? $"Section {i + 1}" : section.SectionName;

                <article class="section-group pattern-section" data-section-index="@i">
                    <div class="section-header">
                        <div class="section-title-group">
                            <div style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem; flex-wrap:wrap; width:100%; margin-bottom:0.75rem;">
                                <label class="section-label" for="@($"Sections_{i}__SectionName")" style="position: relative; top: 4mm;">Section Name</label>
                                <button type="button" class="btn btn-save" onclick="removeSection(this)">🗑️ Remove Section</button>
                                <input type="text"
                                   class="form-control styled-text-input section-name-input"
                                   id="@($"Sections_{i}__SectionName")"
                                   name="Sections[@i].SectionName"
                                   value="@sectionName"
                                   placeholder="Head, Body, Sleeves, etc." />
                            </div>
                        </div>
                    </div>

                    <div class="section-rounds" data-rounds-container>
                        @for (var j = 0; j < roundTexts.Count; j++)
                        {
                            <div class="round-input-group" data-round-index="@j">
                                <div class="round-header">
                                    <label class="round-label">Round @(j + 1)</label>
                                    <button type="button" class="btn-delete-round" onclick="deleteRound(this)" title="Delete this round">🗑️</button>
                                </div>
                                <textarea name="Sections[@i].RoundTexts[@j]" rows="2" class="round-text form-control">@roundTexts[j]</textarea>
                            </div>
                        }
                    </div>

                    <div class="section-actions" style="margin-top: 10px;">
                        <button type="button" class="btn btn-add-round" onclick="addRound(this)">➕ Add Round</button>
                        <button type="button" class="btn btn-validate" onclick="validateSection(this)">✓ Validate Section</button>
                    </div>

                    <div class="section-validation-results" id="sectionResults_@i">
                        @if (section.Rounds.Count > 0)
                        {
                            <h3 class="results-title">Validation Results</h3>
                            <div class="results-list">
                                @foreach (var round in section.Rounds)
                                {
                                    if (!string.IsNullOrEmpty(round.Error))
                                    {
                                        <div class="result-item result-error">
                                            <span class="result-icon">❌</span>
                                            <div class="result-content">
                                                <strong>Round @round.RoundIndex</strong>
                                                <p>@round.Error</p>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="result-item result-success">
                                            <span class="result-icon">✅</span>
                                            <div class="result-content">
                                                <strong>Round @round.RoundIndex</strong>
                                                <p>@round.StitchCount stitches</p>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        <div class="pattern-form-actions">
            <div class="control-buttons">
                <button type="button" 
                        class="btn btn-add-round" 
                        onclick="addSection()">
                        ➕ Add Section
                </button>
                <button type="submit"
                        asp-action="Validate"
                        asp-controller="Pattern"
                        class="btn btn-validate"
                        id="validateButton">
                    ✓ Validate
                </button>
                <button type="submit"
                        asp-action="Save"
                        asp-controller="Pattern"
                        class="btn btn-save"
                        id="saveButton">
                    💾 Save
                </button>
                <button type="button"
                        class="btn btn-save"
                        id="previewButton"
                        onclick="togglePreview()">
                    👁️ Preview
                </button>

            </div>
        </div>
    </form>

    <template id="sectionTemplate">
        <article class="section-group pattern-section" data-section-index="__SECTION_INDEX__">
            <div class="section-header">
                <div class="section-title-group" style="display:flex; align-items:center; justify-content:space-between; gap:0.5rem; flex-wrap:wrap; width:100%; margin-bottom:0.75rem;">
                    <label class="section-label" for="@($"Sections_[__SECTION_INDEX__]__SectionName")" style="position: relative; top: 4mm;">Section Name</label>
                    <button type="button" class="btn btn-save" onclick="removeSection(this)">🗑️ Remove Section</button>
                    <input type="text"
                        class="form-control styled-text-input section-name-input"
                        id="@($"Sections_[__SECTION_INDEX__]__SectionName")"
                        name="Sections[__SECTION_INDEX__].SectionName"
                        value=""
                        placeholder="Head, Body, Sleeves, etc." />
                </div>

            </div>

            <div class="section-rounds" data-rounds-container>
                __ROUND_HTML__
            </div>

            <div class="section-actions">
                <button type="button" class="btn btn-add-round" onclick="addRound(this)">➕ Add Round</button>
                <button type="button" class="btn btn-validate" onclick="validateSection(this)">✓ Validate Section</button>
            </div>

            <div class="section-validation-results" id="sectionResults___SECTION_INDEX__"></div>
        </article>
    </template>

    <template id="roundTemplate">
        <div class="round-input-group" data-round-index="__ROUND_INDEX__">
            <div class="round-header">
                <label class="round-label">Round __ROUND_NUMBER__</label>
                <button type="button" class="btn-delete-round" onclick="deleteRound(this)" title="Delete this round">🗑️</button>
            </div>
            <textarea name="Sections[__SECTION_INDEX__].RoundTexts[__ROUND_INDEX__]" rows="2" class="round-text form-control" value=""></textarea>
        </div>
    </template>

    <div id="patternPreview" class="pattern-preview-container" style="display: none;">
        <div class="section-container">
            <h3 class="results-title">📖 Pattern Preview</h3>
            <div id="previewContent" class="preview-content">
                @if (sections.Count > 0)
                {
                    <div class="preview-header">
                        <h2>@ViewData["Title"]</h2>
                        <p class="preview-date">Created: @DateTime.Now.ToString("MMMM dd, yyyy")</p>
                    </div>

                    @for (var i = 0; i < sections.Count; i++)
                    {
                        var section = sections[i];
                        var sectionName = string.IsNullOrWhiteSpace(section.SectionName) ? $"Section {i + 1}" : section.SectionName;

                        <div class="preview-section">
                            <h3>@sectionName</h3>
                            @for (var j = 0; j < section.RoundTexts.Count; j++)
                            {
                                <div class="preview-round">
                                    <div class="preview-round-header">
                                        <h4>Round @(j + 1)</h4>
                                    </div>
                                    <p class="preview-round-text">@(section.RoundTexts[j])</p>
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="preview-empty">No sections added yet. Add a section to see the preview.</p>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function buildRoundHtml(sectionIndex, roundIndex) {
            return document.getElementById('roundTemplate').innerHTML
                .replace(/__SECTION_INDEX__/g, sectionIndex)
                .replace(/__ROUND_INDEX__/g, roundIndex)
                .replace(/__ROUND_NUMBER__/g, roundIndex + 1);
        }

        function reindexSections() {
            const sections = Array.from(document.querySelectorAll('.pattern-section'));

            sections.forEach((section, sectionIndex) => {
                section.dataset.sectionIndex = sectionIndex;

                const sectionNameInput = section.querySelector('.section-name-input');
                if (sectionNameInput) {
                    sectionNameInput.name = `Sections[${sectionIndex}].SectionName`;
                    sectionNameInput.id = `Sections_${sectionIndex}__SectionName`;
                }

                const results = section.querySelector('.section-validation-results');
                if (results) {
                    results.id = `sectionResults_${sectionIndex}`;
                }

                const rounds = Array.from(section.querySelectorAll('.round-input-group'));
                rounds.forEach((round, roundIndex) => {
                    round.dataset.roundIndex = roundIndex;
                    round.querySelector('.round-label').textContent = `Round ${roundIndex + 1}`;
                    round.querySelector('.round-text').name = `Sections[${sectionIndex}].RoundTexts[${roundIndex}]`;
                });
            });
        }

        function addSection() {
            const sectionsContainer = document.getElementById('sectionsContainer');
            const sectionIndex = sectionsContainer.querySelectorAll('.pattern-section').length;
            const sectionName = `Section ${sectionIndex + 1}`;
            const sectionHtml = document.getElementById('sectionTemplate').innerHTML
                .replace(/__SECTION_INDEX__/g, sectionIndex)
                .replace(/__SECTION_NAME__/g, sectionName)
                .replace(/__ROUND_HTML__/g, buildRoundHtml(sectionIndex, 0));

            sectionsContainer.insertAdjacentHTML('beforeend', sectionHtml);
            reindexSections();
        }

        function removeSection(button) {
            const sectionsContainer = document.getElementById('sectionsContainer');
            if (sectionsContainer.querySelectorAll('.pattern-section').length <= 1) {
                return;
            }

            button.closest('.pattern-section').remove();
            reindexSections();
        }

        function addRound(button) {
            const section = button.closest('.pattern-section');
            const sectionIndex = Array.from(document.querySelectorAll('.pattern-section')).indexOf(section);
            const roundsContainer = section.querySelector('[data-rounds-container]');
            const roundIndex = roundsContainer.querySelectorAll('.round-input-group').length;

            roundsContainer.insertAdjacentHTML('beforeend', buildRoundHtml(sectionIndex, roundIndex));
            reindexSections();
        }

        function deleteRound(button) {
            const section = button.closest('.pattern-section');
            const rounds = section.querySelectorAll('.round-input-group');
            if (rounds.length <= 1) {
                return;
            }

            button.closest('.round-input-group').remove();
            reindexSections();
        }

        async function validateSection(button) {
            const section = button.closest('.pattern-section');
            const sectionIndex = Array.from(document.querySelectorAll('.pattern-section')).indexOf(section);
            const sectionName = section.querySelector('.section-name-input')?.value?.trim() || `Section ${sectionIndex + 1}`;
            const roundTexts = Array.from(section.querySelectorAll('.round-text')).map(textarea => textarea.value);

            const response = await fetch('@Url.Action("ValidateSection", "Pattern")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    sectionIndex: sectionIndex,
                    sectionName: sectionName,
                    roundTexts: roundTexts
                })
            });

            const data = await response.json();
            const resultsContainer = section.querySelector('.section-validation-results');
            const resultHtml = (data.rounds || []).map(round => {
                if (round.error) {
                    return `
                        <div class="result-item result-error">
                            <span class="result-icon">❌</span>
                            <div class="result-content">
                                <strong>Round ${round.roundIndex}</strong>
                                <p>${round.error}</p>
                            </div>
                        </div>`;
                }

                return `
                    <div class="result-item result-success">
                        <span class="result-icon">✅</span>
                        <div class="result-content">
                            <strong>Round ${round.roundIndex}</strong>
                            <p>${round.stitchCount} stitches</p>
                        </div>
                    </div>`;
            }).join('');

            resultsContainer.innerHTML = `
                <h3 class="results-title">${data.sectionName || sectionName}</h3>
                <div class="results-list">${resultHtml}</div>`;
        }

        function previewImage(event) {
            const file = event.target.files[0];
            if (!file) {
                return;
            }

            const reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('previewImg').src = e.target.result;
                document.getElementById('imagePreview').style.display = 'block';
            };

            reader.readAsDataURL(file);
        }

        function togglePreview() {
            const preview = document.getElementById('patternPreview');
            preview.style.display = preview.style.display === 'none' ? 'block' : 'none';
        }

        document.getElementById('patternForm')?.addEventListener('submit', () => {
            reindexSections();
        });
    </script>
}