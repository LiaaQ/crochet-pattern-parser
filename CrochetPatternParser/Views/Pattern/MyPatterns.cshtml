@model List<CrochetPatternParser.Data.PatternEntity>

<h2>My Saved Patterns</h2>

@if (!Model.Any())
{
    <p>You have no saved patterns.</p>
}
else
{
    <ul>
        @foreach (var pattern in Model)
        {
            <li>
                <strong>Saved:</strong> @pattern.CreatedAt.ToLocalTime()<br />

                <strong>Title:</strong> @pattern.Title<br />

                <a asp-action="Edit" asp-route-id="@pattern.Id">Edit</a>
            </li>
        }
    </ul>
}
