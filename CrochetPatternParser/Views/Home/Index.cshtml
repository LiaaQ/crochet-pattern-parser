@* Add Quicksand font for Home only *@
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
<style>
    .home-page, .home-page p, .home-page li, .home-page a, .home-page strong {
        font-family: 'Quicksand', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 1.08rem;
        font-weight: 400;
        letter-spacing: 0.01em;
    }
</style>

@{
    ViewData["Title"] = "Home Page";
}

<div class="home-page">
    <div class="page-header">
        <h1>Welcome to the Crochet Pattern Validator!</h1>
    </div>
    <p>
        This tool is designed to help you validate your crochet patterns. No more math errors and inconsistent round counts!
    </p>

    <button class="btn btn-save" onclick="location.href='/Account/Login'">Get Started</button>

    <div class="page-header">
        <h2>How to Use</h2>
    </div>

    <table border="1" cellpadding="8" cellspacing="0" align="center">
        <tr>
            <th></th>
            <th>Name</th>
            <th>Abbreviation</th>
        </tr>
        <tr>
            <th><img src="/images/symbols/slst.svg" alt="Slip stitch symbol" class="crochet-symbol"/></th>
            <td>slip stitch</td>
            <td>slst</td>
        </tr>
        <tr>
            <th><img src="/images/symbols/sc.svg" alt="Single crochet symbol" class="crochet-symbol"/></th>
            <td>single crochet</td>
            <td>sc</td>
        </tr>
        <tr>
            <th><img src="/images/symbols/inc.svg" alt="Increase symbol" class="crochet-symbol"/></th>
            <td>increase</td>
            <td>inc</td>
        </tr>
        <tr>
            <th><img src="/images/symbols/dec.svg" alt="Decrease symbol" class="crochet-symbol"/></th>
            <td>decrease</td>
            <td>dec</td>
        </tr>
        <tr>
            <th><img src="/images/symbols/hdc.svg" alt="Half double crochet symbol" class="crochet-symbol"/></th>
            <td>half double crochet</td>
            <td>hdc</td>
        </tr>
        <tr>
            <th><img src="/images/symbols/dc.svg" alt="Double crochet symbol" class="crochet-symbol"/></th>
            <td>double crochet</td>
            <td>dc</td>
        </tr>
        <tr>
            <th><img src="/images/symbols/tr.svg" alt="Triple crochet symbol" class="crochet-symbol"/></th>
            <td>triple crochet</td>
            <td>tr</td>
        </tr>
        <tr>
            <td></td>
            <td>skip a stitch</td>
            <td>sk</td>
        </tr>
        <tr>
            <td></td>
            <td>repeat the instruction # times</td>
            <td>(...) #</td>
        </tr>
        <tr>
            <td></td>
            <td>work in the same stitch</td>
            <td>[...]</td>
        </tr>
        <tr>
            <td></td>
            <td>switch to color X</td>
            <td>&#64;X</td>
        </tr>
    </table>

    </div>