@* Add Quicksand font for Home only *@
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@400;600;700&display=swap" rel="stylesheet">
<style>
    .home-page, .home-page p, .home-page li, .home-page a, .home-page strong {
        font-family: 'Quicksand', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 1.08rem;
        font-weight: 400;
        letter-spacing: 0.01em;
    }
</style>

@{
    ViewData["Title"] = "Home Page";
}

<div class="home-page">
    <div class="page-header">
        <h1>Welcome to the Crochet Pattern Validator!</h1>
    </div>
    <p>
        This tool is designed to help you validate your crochet patterns. No more math errors and inconsistent round counts!
    </p>

    <button class="btn btn-save" onclick="location.href='/Account/Login'">Get Started</button>
</div>